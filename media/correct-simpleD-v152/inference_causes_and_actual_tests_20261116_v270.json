  "已确认的推理问题": [
    {
      "问题": "旧短窗口把源视频时间位置编码起点放在6或11，训练原生81帧对应起点应为21。",
      "修正": "21/41帧窗显式恢复源起点21；原生81帧目标21潜帧+源21潜帧自然满足，不重复打补丁。",
      "限度": "单独修正该项不足以证明所有历史彩噪已解决。"
    },
    {
      "问题": "异常生成帧继续作下一窗口参考，会累积并放大异常。",
      "修正": "本批短窗改为固定、同源时间的视频参考，避免把这些短窗的坏RGB递归反馈。",
      "限度": "复杂舞蹈使用独立VideoX当前视频先验；D使用同例DD81固定生成参考，均非真值。稳定结果是明确改变后的推理协议，不能归结成单一一行修复。"
    },
    {
      "问题": "独立窗口的latent拼接后统一VAE解码，改变了各窗原有的因果上下文，引入额外闪动和重影。",
      "修正": "保持同一份DD采样结果，按各原窗口独立使用官方VAE解码；完整原生帧按源时间排列，仅去重参考帧与EOF条件占位。",
      "证据": "D21静态背景帧间变化1.0710→0.3812；D41为0.6058→0.3639；原28项逐项对照数据随附。没有重新采样、平滑、插帧或最终像素修补。",
      "限度": "这些ROI指标不替代动作、细节、几何和剩余闪动验收。"
    }
  ],
  "输入执行校验": [
    "固定正确案例、原片帧号、Stage2首帧和文件哈希；错选室内舞蹈case12归档不计数。",
    "实际送入模型的RGB和源/相机张量核对；解码环境产生的RGB不一致已在模型调用前拦截，并用原生环境重建。",
    "检查实际调用而非只看命令参数：CFG1、LoRA1、50步/50次DD；控制网络和STG额外调用单独记录。",
    "保存实际初始/最终latent、采样轨迹和代码快照；输出逐帧无损哈希检查，覆盖247/81个真实源帧和EOF。",
    "关闭新适配时须实际NN张量及全部RGB与基线一致；新增方法首个正样本须先全帧及EOF检查，再允许扩大强度/组合/案例。",
    "后续候选按原窗口VAE上下文解码后再比较；新增方法失败不得混入已修复原批。",
    "复杂运动相机必须覆盖代表性中段，并检查全部真实帧；首尾阳性门槛不足。所有新增强度/组合须在首个正样本完整视觉检查后再排队，已有SAN组合提前启动的事实已保留。"
